# ==========================================
# OpsTracker — Environment Variables Example
# Copy this file to .env before running Docker Compose or local dev
# ==========================================

# --- Application Ports & Runtime ---
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=8080
CORS_ORIGIN=*

# --- PostgreSQL (Docker image: postgres:16) ---
POSTGRES_USER=opstracker
POSTGRES_PASSWORD=opstracker_pass
POSTGRES_DB=opstracker
POSTGRES_PORT=5432
# Used when running backend locally outside Docker:
DATABASE_URL=postgresql://opstracker:opstracker_pass@localhost:5432/opstracker

# --- OpenObserve (Observability Platform) ---
OPENOBSERVE_PORT=5080
OPENOBSERVE_ORG=default
OPENOBSERVE_OTEL_STREAM=opstracker_logs
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123

# --- OpenTelemetry (OTLP/HTTP -> OpenObserve) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=opstracker-backend
OTEL_SERVICE_VERSION=1.0.0
# Local backend -> local OpenObserve; in docker-compose this is overridden to http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
# Optional: leave empty to auto-generate Basic auth from OPENOBSERVE_USER + OPENOBSERVE_PASSWORD
OTEL_EXPORTER_OTLP_AUTH_HEADER=

# --- Frontend (Vite dev mode only) ---
# Leave empty when using Vite proxy (/api -> backend) or Nginx reverse proxy
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:3001
