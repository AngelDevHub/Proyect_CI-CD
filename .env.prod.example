# ==============================================================================
# OpsTracker — Production Environment (.env.prod)
# Set these variables on your AWS EC2 instance before starting docker-compose.prod.yml
# ==============================================================================

# --- Application Runtime & Ports ---
NODE_ENV=production
FRONTEND_PORT=80
BACKEND_PORT=3001
CORS_ORIGIN=*

# --- PostgreSQL (Database) ---
POSTGRES_USER=opstracker
POSTGRES_PASSWORD=opstracker_secure_pass_2026
POSTGRES_DB=opstracker

# --- OpenObserve (Observability Platform) ---
OPENOBSERVE_PORT=5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123
OPENOBSERVE_OTEL_STREAM=opstracker_logs
OPENOBSERVE_METRICS_STREAM=ec2_metrics

# --- OpenTelemetry (App Logs, Traces & Metrics -> OpenObserve) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=opstracker-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# --- EC2 Host Infrastructure Metrics Collector ---
METRICS_INTERVAL_SECONDS=10
