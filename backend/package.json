{
  "name": "opstracker-backend",
  "version": "1.0.0",
  "description": "OpsTracker Backend API with Fastify, PostgreSQL, and OpenTelemetry OTLP/HTTP for OpenObserve",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "jest --runInBand --forceExit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "0.57.2",
